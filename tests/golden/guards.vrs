// Doc 18 §2.3. Equations, pattern rows and the `|` guard ladder, checked by
// running the generated Rust: a ladder lowered to the wrong chain prints the
// wrong word.

// A ladder, with `_` as the final catch-all — the same wildcard a `case` arm and
// a parameter pattern use. Row 99 wave 2 deleted `otherwise`: one spelling for
// one meaning, and the keyword it cost was the eleventh of fifty-eight.
fn tier(spend: u64) -> &'static str {
    if spend > 10_000 {
        "platinum"
    } else if spend > 1_000 {
        "gold"
    } else {
        "basic"
    }
}

// Several equations, each with a short body on the `=` line.
fn fib(n: u64) -> u64 {
    match n {
        0 => 0,
        1 => 1,
        n => fib(n - 1) + fib(n - 2),
    }
}

// A pattern row and a ladder on the same function: the ladder lands inside
// the clause's `match` arm.
fn step(n: u64) -> u64 {
    match n {
        0 => 0,
        n => {
            if n > 100 {
                100
            } else {
                n
            }
        }
    }
}

// Equations bind `a` in different positions, so neither parameter takes the
// name: two Rust parameters cannot share it.
fn pick(__vlt_a0: u64, __vlt_a1: u64) -> u64 {
    match (__vlt_a0, __vlt_a1) {
        (a, 0) => a,
        (0, a) => a,
        (_, _) => 0,
    }
}

fn main() {
    println!("{}", tier(50_000));
    println!("{}", tier(5_000));
    println!("{}", tier(10));
    println!("{}", fib(10));
    println!("{}", step(0));
    println!("{}", step(500));
    println!("{}", step(7));
    println!("{}", pick(3, 0));
    println!("{}", pick(0, 4));
    ();
}
