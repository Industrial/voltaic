-- leaf: v3
-- gap: G3
-- `use_resource(move || { let owned = s.clone(); async move { ... } })`, the
-- Dioxus idiom, checked under rustc against a stub with its `'static` bounds.
rust """
  pub struct Resource<T>(core::marker::PhantomData<T>);
  pub fn use_resource<T, F, Fut>(_f: F) -> Resource<T>
  where
      F: FnMut() -> Fut + 'static,
      Fut: core::future::Future<Output = T> + 'static,
  {
      Resource(core::marker::PhantomData)
  }
"""

export lengths : String -> Resource<usize>
lengths s =
  use_resource (move \->
    owned = s.clone ()
    async move
      owned.len ())
