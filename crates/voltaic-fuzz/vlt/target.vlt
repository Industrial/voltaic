export emit_program : &[u8] -> ()
emit_program bytes =
  text = String::from_utf8_lossy bytes
  mut program = case voltaic_parser::parse_source (&text) of
    Ok p -> p
    Err _ ->
      return ()
  analysis = voltaic_driver::analyse (&mut program)
  if !.is_empty analysis.open
    return ()
  scope = voltaic_emit::MethodScope::enter (voltaic_emit::MethodTable::from_spans (.as_slice analysis.methods))
  _dropped = voltaic_emit::emit (&program)
  drop scope
  ()

export lex_source : &[u8] -> ()
lex_source bytes =
  text = String::from_utf8_lossy bytes
  _dropped = voltaic_lexer::lex (&text)
  ()

export parse_program : &[u8] -> ()
parse_program bytes =
  text = String::from_utf8_lossy bytes
  _dropped = voltaic_parser::parse_source (&text)
  ()

export roundtrip : &[u8] -> Option<String>
roundtrip bytes =
  text = String::from_utf8_lossy bytes
  mut program = (.ok (voltaic_parser::parse_source (&text)))?
  analysis = voltaic_driver::analyse (&mut program)
  if !.is_empty analysis.open
    return None
  scope = voltaic_emit::MethodScope::enter (voltaic_emit::MethodTable::from_spans (.as_slice analysis.methods))
  rendered = voltaic_emit::emit (&program)
  drop scope
  Some rendered

export solve_program : &[u8] -> Option<u32>
solve_program bytes =
  text = String::from_utf8_lossy bytes
  program = (.ok (voltaic_parser::parse_source (&text)))?
  found = voltaic_lattice::walk (&program)
  outcome = voltaic_lattice::solve (&found.store)
  Some outcome.rounds
