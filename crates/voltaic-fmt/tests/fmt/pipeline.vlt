-- Doc 03 §5.3's pipeline, in its one canonical layout. `pipeline.canonical.vlt`
-- is this file formatted, compared as whole files — so every comment here
-- reaches both halves of the pair, trivia being the one thing a formatter may
-- never lose.
--
-- The layout is not a style choice among several: the lexer continues a line
-- that *opens* with `|>`, and only `|>`, so one stage per continuation line
-- indented beneath the receiver is the only multi-line spelling of a pipeline
-- that parses. Since 0.3.0 it is also the only spelling the formatter writes,
-- whatever the pipeline's width.

doubled : Vec<i32> -> usize
doubled numbers = numbers |> .iter |> filter (\n -> *n % 2 == 0) |> map (\n -> n * 2) |> count

main : ()
main =
  -- Short enough to fit on one line, and broken anyway: a pipeline is a
  -- sequence of stages, and the layout says so at any width.
  short = items |> map (+1) |> filter (> 0)
  -- A single stage breaks too.
  single = items |> map (+1)
  -- Already broken, which is the idempotence half of the rule.
  kept = numbers
    |> .iter
    |> filter (\n -> *n % 2 == 0)
    |> map (\n -> n * 2)
    |> count
  -- Half broken, which joins nothing and breaks the rest.
  half = numbers |> .iter
    |> count
  println! \-> "#{short}"
  ()
