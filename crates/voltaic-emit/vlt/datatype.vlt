import crate::expr::emit_expr
import crate::expr::field_value
import crate::expr::unparen
import crate::item::emit_clauses
import crate::item::generics
import crate::item::signature
import crate::pattern::emit_templates
import crate::sink::RUST_INDENT
import crate::sink::Sink
import crate::sink::emit_trivia
import crate::sink::pad
import crate::template::TemplateScope
import voltaic_ast::ClassDecl
import voltaic_ast::ClassMember
import voltaic_ast::Constructor
import voltaic_ast::ConstructorFields
import voltaic_ast::DataDecl
import voltaic_ast::ErrorsDecl
import voltaic_ast::Expr
import voltaic_ast::FieldInit
import voltaic_ast::Ident
import voltaic_ast::InstanceDecl
import voltaic_ast::TypeApp
import voltaic_ast::TypeExpr
import voltaic_ast::Visibility

export(crate) emit_class : &mut Sink<'_> -> &ClassDecl -> usize -> ()
emit_class out c indent =
  .unmark out
  emit_trivia out (&c.leading) indent
  .mark c.span out
  pad out indent
  vis = .rust_text c.visibility
  .push_str (&format! \-> "#{vis}trait #{c.name.text}") out
  if !.is_empty c.params
    params : Vec<String> = (c.params.iter ().map (\p -> TypeApp::rust_name (&p.text))).collect ()
    joined = .join ", " params
    .push_str (&format! \-> "<#{joined}>") out
  if !.is_empty c.supers
    names : Vec<&str> = (c.supers.iter ().map (\s -> .as_str s.text)).collect ()
    joined = .join " + " names
    .push_str (&format! \-> ": #{joined}") out
  .push_str " {\n" out
  for m in &c.members
    emit_member out m (indent + RUST_INDENT)
  .unmark out
  pad out indent
  .push_str "}\n" out
  ()

export(crate) const ALL_DERIVES : &[&str] = &["Debug", "Clone", "Copy", "PartialEq", "Eq", "PartialOrd", "Ord", "Hash"]

export(crate) supported : &str -> Option<&'static [&'static str]>
supported text = case .trim text of
  "u8" or "u16" or "u32" or "u64" or "u128" or "usize" or "i8" or "i16" or "i32" or "i64" or "i128" or "isize" or "bool" or "char" or "()" -> Some ALL_DERIVES
  "&str" or "&'static str" -> Some ALL_DERIVES
  "f32" or "f64" -> Some (&["Debug", "Clone", "Copy", "PartialEq", "PartialOrd"])
  "String" -> Some (&["Debug", "Clone", "PartialEq", "Eq", "PartialOrd", "Ord", "Hash"])
  _ -> None

export(crate) field_types : &DataDecl -> Vec<String>
field_types d =
  mut found = Vec::new ()
  for c in .iter d.constructors
    case &c.fields of
      ConstructorFields::Unit -> ()
      ConstructorFields::Tuple types ->
        for t in types
          found.push (.clone t.text)
        ()
      ConstructorFields::Record fields ->
        for f in fields
          found.push (.clone f.ty.text)
        ()
  found

export(crate) writes_its_own_derives : &DataDecl -> bool
writes_its_own_derives d = d.leading.iter ().any (\t -> .starts_with "derive(" (.trim (.as_str t.text)))

export(crate) computed_derives : &DataDecl -> Vec<&'static str>
computed_derives d =
  if d.is_union || writes_its_own_derives d
    return Vec::new ()
  mut kept : Vec<&'static str> = .to_vec ALL_DERIVES
  for text in field_types d
    guard supported (.as_str text) is Some allowed else
      return Vec::new ()
    .retain (\name -> .contains name allowed) kept
  if d.no_copy
    .retain (\name -> *name != "Copy") kept
  kept

export(crate) is_error_type : &DataDecl -> bool
is_error_type d = .any (\c -> .is_some c.message) (.iter d.constructors)

export(crate) payload_types : &ConstructorFields -> Vec<TypeExpr>
payload_types fields = case fields of
  ConstructorFields::Tuple types -> .to_vec (.as_slice types)
  _ -> Vec::new ()

export(crate) as_variant : &Constructor -> voltaic_ast::ErrorVariant
as_variant c =
  shown = .unwrap_or_default (.cloned (.as_ref c.message))
  voltaic_ast::ErrorVariant {
    name = .clone c.name,
    fields = payload_types (&c.fields),
    from = false,
    message = shown,
    leading = .clone c.leading,
    span = c.span,
  }

export(crate) as_errors : &DataDecl -> ErrorsDecl
as_errors d =
  variants : Vec<voltaic_ast::ErrorVariant> = (d.constructors.iter ().map as_variant).collect ()
  ErrorsDecl {
    name = .clone d.name,
    variants,
    visibility = .clone d.visibility,
    span = d.span,
    leading = .clone d.leading,
  }

export(crate) emit_data : &mut Sink<'_> -> &DataDecl -> usize -> ()
emit_data out d indent =
  if is_error_type d
    emit_errors out (&as_errors d) indent
    return ()
  .mark d.span out
  emit_trivia out (&d.leading) indent
  templated : Vec<Ident> = (d.derives.iter ().filter (\i -> .is_some (TemplateScope::lookup (.as_str i.text)))).cloned ().collect ()
  computed = computed_derives d
  builtin : Vec<&str> = if .is_empty d.derives
    .to_vec (.as_slice computed)
  else
    ((d.derives.iter ().filter (\i -> .is_none (TemplateScope::lookup (.as_str i.text)))).map (\i -> .as_str i.text)).collect ()
  if !.is_empty builtin
    joined = .join ", " builtin
    pad out indent
    .push_str (&format! \-> "\#[derive(#{joined})]\n") out
  as_struct = case .as_slice d.constructors of
    [only] -> only.name.text == d.name.text
    [] -> true
    _ -> false
  params = if .is_empty d.generics
    String::new ()
  else
    joined = .join ", " d.generics
    format! \-> "<#{joined}>"
  if as_struct
    fields = .map_or (&ConstructorFields::Unit) (\c -> &c.fields) (.first d.constructors)
    if d.is_newtype
      pad out indent
      .push_str "#[repr(transparent)]\n" out
    pad out indent
    vis = .rust_text d.visibility
    keyword = if d.is_union
      "union"
    else
      "struct"
    .push_str (&format! \-> "#{vis}#{keyword} #{d.name.text}#{params}") out
    shown : &[Visibility] = case .first d.constructors of
      Some c -> .as_slice c.field_visibility
      None -> &[]
    emit_fields out fields shown indent true
    emit_templates out (&templated) d indent
    return ()
  pad out indent
  vis = .rust_text d.visibility
  .push_str (&format! \-> "#{vis}enum #{d.name.text}#{params} {\n") out
  for c in &d.constructors
    .mark c.span out
    emit_trivia out (&c.leading) (indent + RUST_INDENT)
    pad out (indent + RUST_INDENT)
    .push_str (&c.name.text) out
    emit_fields out (&c.fields) (.as_slice c.field_visibility) (indent + RUST_INDENT) false
  .unmark out
  pad out indent
  .push_str "}\n" out
  pad out indent
  .push_str "#[allow(unused_imports)]\n" out
  pad out indent
  .push_str (&format! \-> "use #{d.name.text}::*;\n") out
  emit_templates out (&templated) d indent
  ()

export(crate) error_message : &str -> (String, Vec<String>)
error_message raw =
  text = .trim_matches '"' raw
  mut template = String::with_capacity (.len text)
  mut args = Vec::new ()
  chars : Vec<char> = text.chars ().collect ()
  mut i = 0
  while i < .len chars
    if chars[i] == '#' && .get (i + 1) chars == Some (&'{')
      mut j = i + 2
      mut digits = String::new ()
      while j < .len chars && .is_ascii_digit chars[j]
        .push chars[j] digits
        j += 1
      if !.is_empty digits && .get j chars == Some (&'}')
        .push_str "{}" template
        .push (format! \-> "_#{digits}") args
        i := j + 1
        continue
    if chars[i] == '{' || chars[i] == '}'
      .push chars[i] template
    .push chars[i] template
    i += 1
  (template, args)

export(crate) emit_errors : &mut Sink<'_> -> &ErrorsDecl -> usize -> ()
emit_errors out d indent =
  .unmark out
  emit_trivia out (&d.leading) indent
  .mark d.span out
  name = &d.name.text
  pad out indent
  .push_str "#[derive(Debug)]\n" out
  pad out indent
  vis = .rust_text d.visibility
  .push_str (&format! \-> "#{vis}enum #{name} {\n") out
  for v in &d.variants
    .mark v.span out
    emit_trivia out (&v.leading) (indent + RUST_INDENT)
    pad out (indent + RUST_INDENT)
    .push_str (&v.name.text) out
    if !.is_empty v.fields
      texts : Vec<&str> = (v.fields.iter ().map (\t -> .as_str t.text)).collect ()
      joined = .join ", " texts
      .push_str (&format! \-> "(#{joined})") out
    .push_str ",\n" out
  .unmark out
  pad out indent
  .push_str "}\n\n" out
  pad out indent
  .push_str "#[allow(unused_imports)]\n" out
  pad out indent
  .push_str (&format! \-> "use #{name}::*;\n\n") out
  pad out indent
  .push_str (&format! \-> "impl std::fmt::Display for #{name} {\n") out
  pad out (indent + RUST_INDENT)
  .push_str "fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n" out
  pad out (indent + RUST_INDENT * 2)
  .push_str "match self {\n" out
  for v in &d.variants
    .mark v.span out
    built = error_message (&v.message)
    count = .len v.fields
    binders : Vec<String> = ((0 .. count).map (\i -> format! \-> "_#{i}")).collect ()
    pad out (indent + RUST_INDENT * 3)
    .push_str (&format! \-> "#{name}::#{v.name.text}") out
    if !.is_empty binders
      joined = .join ", " binders
      .push_str (&format! \-> "(#{joined})") out
    .push_str (&format! \-> " => write!(f, \"#{built.0}\"") out
    for arg in &built.1
      .push_str (&format! \-> ", #{arg}") out
    .push_str "),\n" out
  .unmark out
  pad out (indent + RUST_INDENT * 2)
  .push_str "}\n" out
  pad out (indent + RUST_INDENT)
  .push_str "}\n" out
  pad out indent
  .push_str "}\n\n" out
  pad out indent
  .push_str (&format! \-> "impl std::error::Error for #{name} {}\n") out
  for v in &d.variants
    if !v.from
      continue
    ty = &v.fields[0].text
    .mark v.span out
    .push '\n' out
    pad out indent
    .push_str (&format! \-> "impl From<#{ty}> for #{name} {\n") out
    pad out (indent + RUST_INDENT)
    .push_str (&format! \-> "fn from(e: #{ty}) -> Self {\n") out
    pad out (indent + RUST_INDENT * 2)
    .push_str (&format! \-> "#{name}::#{v.name.text}(e)\n") out
    pad out (indent + RUST_INDENT)
    .push_str "}\n" out
    pad out indent
    .push_str "}\n" out
  .unmark out
  ()

export(crate) unparenthesised : &str -> &str
unparenthesised text =
  guard .strip_prefix "(" text is Some rest else
    return text
  guard .strip_suffix ")" rest is Some inner else
    return text
  if .is_empty (.trim inner)
    return text
  mut depth : i32 = 0
  for ch in .chars inner
    case ch of
      '(' or '<' or '[' -> depth += 1
      ')' or '>' or ']' ->
        depth -= 1
        if depth < 0
          return text
      _ | ch == ',' && depth == 0 ->
        return text
      _ -> ()
  inner

export(crate) emit_fields : &mut Sink<'_> -> &ConstructorFields -> &[Visibility] -> usize -> bool -> ()
emit_fields out fields visibilities indent top =
  case fields of
    ConstructorFields::Unit ->
      closer = if top
        ";\n"
      else
        ",\n"
      .push_str closer out
    ConstructorFields::Tuple types ->
      texts : Vec<String> = (types.iter ().enumerate ().map (\pair ->
        vis = .map_or (String::new ()) Visibility::rust_text (.get pair.0 visibilities)
        format! \-> "#{vis}#{(unparenthesised (&pair.1.text))}")).collect ()
      joined = .join ", " texts
      .push_str (&format! \-> "(#{joined})") out
      closer = if top
        ";\n"
      else
        ",\n"
      .push_str closer out
    ConstructorFields::Record decls ->
      texts : Vec<String> = (decls.iter ().map (\f ->
        vis = .rust_text f.visibility
        format! \-> "#{vis}#{f.name.text}: #{f.ty.text}")).collect ()
      joined = .join ", " texts
      documented = .any (\f -> !.is_empty f.leading) (.iter decls)
      if !top && !documented && .len joined <= STRUCT_VARIANT_WIDTH
        .push_str (&format! \-> " { #{joined} },\n") out
        return ()
      .push_str " {\n" out
      for f in decls
        .mark f.span out
        emit_trivia out (&f.leading) (indent + RUST_INDENT)
        pad out (indent + RUST_INDENT)
        vis = .rust_text f.visibility
        .push_str (&format! \-> "#{vis}#{f.name.text}: #{f.ty.text},\n") out
      .unmark out
      pad out indent
      closer = if top
        "}\n"
      else
        "},\n"
      .push_str closer out
  ()

export(crate) emit_instance : &mut Sink<'_> -> &InstanceDecl -> usize -> ()
emit_instance out i indent =
  .unmark out
  emit_trivia out (&i.leading) indent
  .mark i.span out
  pad out indent
  .push_str "impl" out
  if &i.r#given is Some text
    .push_str text out
  else
    .push_str (&generics (&i.target) (&i.constraints)) out
  .push ' ' out
  if &i.r#class is Some named
    lowered = .rust_text named
    .push_str (&format! \-> "#{lowered} for ") out
  .push_str (&.rust_text i.target) out
  .push_str " {\n" out
  for m in &i.members
    emit_member out m (indent + RUST_INDENT)
  .unmark out
  pad out indent
  .push_str "}\n" out
  ()

export(crate) emit_member : &mut Sink<'_> -> &ClassMember -> usize -> ()
emit_member out m indent =
  case m of
    ClassMember::AssocType { name, generics, value, leading } ->
      .unmark out
      emit_trivia out leading indent
      .mark name.span out
      pad out indent
      params = .map_or "" String::as_str (.as_ref generics)
      .push_str (&format! \-> "type #{name.text}#{params}") out
      if value is Some ty
        .push_str (&format! \-> " = #{ty.text}") out
      .push_str ";\n" out
    ClassMember::AssocConst { name, ty, value, visibility, leading } ->
      .unmark out
      emit_trivia out leading indent
      .mark name.span out
      pad out indent
      vis = .rust_text visibility
      .push_str (&format! \-> "#{vis}const #{name.text}: #{ty.text}") out
      if value is Some v
        .push_str (&format! \-> " = #{emit_expr v indent}") out
      .push_str ";\n" out
    ClassMember::Method f ->
      .unmark out
      emit_trivia out (&f.leading) indent
      .mark f.span out
      pad out indent
      sig = signature (&f.sig) indent
      vis = .rust_text f.visibility
      const_marker = if f.sig.is_const
        "const "
      else
        ""
      async_marker = if f.sig.is_async
        "async "
      else
        ""
      .push_str (&format! \-> "#{vis}#{const_marker}#{async_marker}fn #{f.name.text}#{sig}") out
      if .is_empty f.clauses
        .push_str ";\n" out
        return ()
      if .contains '\n' sig
        .push '\n' out
        pad out indent
      else
        .push ' ' out
      .push_str "{\n" out
      emit_clauses out f indent
      .unmark out
      pad out indent
      .push_str "}\n" out
  ()

export(crate) names_a_constructor : &Expr -> bool
names_a_constructor head =
  name = case head of
    Expr::Ident i -> .as_str i.text
    Expr::Path { text, .. } -> .unwrap_or text (.next (.rsplit "::" text))
    _ ->
      return false
  name.chars ().next ().is_some_and char::is_uppercase

export(crate) one_field : &FieldInit -> usize -> String
one_field f indent = case &f.value of
  Some _ -> format! \-> "#{f.name.text}: #{field_value f indent}"
  None -> .clone f.name.text

export(crate) emit_record : &Expr -> &[FieldInit] -> Option<&Expr> -> usize -> String
emit_record head fields rest indent =
  inner_pad = .repeat (indent + RUST_INDENT) " "
  close_pad = .repeat indent " "
  if !names_a_constructor head && .is_none rest
    base = emit_expr (unparen head) (indent + RUST_INDENT)
    mut updated = format! \-> "{\n#{inner_pad}let mut __vlt_r = #{base};\n"
    for f in fields
      value = field_value f (indent + RUST_INDENT)
      .push_str (&format! \-> "#{inner_pad}__vlt_r.#{f.name.text} = #{value};\n") updated
    .push_str (&format! \-> "#{inner_pad}__vlt_r\n#{close_pad}}") updated
    return updated
  head_text = emit_expr (unparen head) indent
  if .is_empty fields && .is_none rest
    return head_text
  mut texts : Vec<String> = (fields.iter ().map (\f -> one_field f indent)).collect ()
  if rest is Some spread
    .push (format! \-> "..#{(emit_expr spread indent)}") texts
  joined = .join ", " texts
  if .len joined <= STRUCT_LIT_WIDTH && !.contains '\n' joined
    return format! \-> "#{head_text} { #{joined} }"
  mut text = format! \-> "#{head_text} {\n"
  for f in fields
    one = one_field f (indent + RUST_INDENT)
    .push_str (&format! \-> "#{inner_pad}#{one},\n") text
  if rest is Some spread
    .push_str (&format! \-> "#{inner_pad}..#{(emit_expr spread (indent + RUST_INDENT))}\n") text
  .push_str (&format! \-> "#{close_pad}}") text
  text

export(crate) const STRUCT_LIT_WIDTH : usize = 18

export(crate) const STRUCT_VARIANT_WIDTH : usize = 34
