import crate::annotation
import crate::constraint::Obligation
import crate::driver::arrow_of
import crate::reason::Reason
import crate::store::Store
import crate::ty::Ty
import voltaic_ast::BinaryOp
import voltaic_ast::Block
import voltaic_ast::ClassMember
import voltaic_ast::ClauseBody
import voltaic_ast::Expr
import voltaic_ast::Item
import voltaic_ast::Program
import voltaic_ast::Visibility

export data Inferred {
  export name String,
  export ty Ty,
  export row crate::row::Row,
  export modes Vec<(String, crate::mode::Mode)>,
  export written Option<Ty>,
  export written_modes Vec<(String, crate::mode::Mode)>,
  export published bool,
  export owner Option<String>,
  export span voltaic_ast::Span,
}
  deriving (Debug, Clone)

instance Inferred
  export judged : &crate::driver::Outcome -> &self -> Ty
  judged outcome self = self_free (&.resolved (&self.ty) outcome) self

  export declared : &self -> Option<Ty>
  declared self =
    written = (.as_ref self.written)?
    Some (self_free written self)

self_free : &Ty -> &Inferred -> Ty
self_free t definition =
  if .as_deref definition.owner is Some target
    return annotation::with_owner t target
  .clone t

export data Report {
  export store Store,
  export definitions Vec<Inferred>,
  export known crate::declarations::Declarations,
  export constants Vec<(String, Ty)>,
}
  deriving (Debug, Clone)

instance Report
  export find : &str -> &self -> Option<&Inferred>
  find name self = .find (\d -> d.name == name) (.iter self.definitions)

export const GLOBAL_ROUNDS : u32 = 4

export walk : &Program -> Report
walk program =
  known = crate::declarations::collect program
  mut globals = written_globals program
  mut built = infer_all program (.as_slice globals)
  mut rounds = 0
  while rounds < GLOBAL_ROUNDS
    rounds += 1
    outcome = crate::driver::solve_with (&built.0) (&known)
    grown = grown_globals (.as_slice built.1) (&outcome) (.as_slice globals)
    if .len grown == .len globals
      break
    globals := grown
    built := infer_all program (.as_slice globals)
  store = built.0
  mut definitions = built.1
  raise_receivers (.as_mut_slice definitions) program
  raise_rows (.as_mut_slice definitions) program
  constants = published_constants program
  Report {
    store,
    definitions,
    known,
    constants,
  }

published_constants : &Program -> Vec<(String, Ty)>
published_constants program =
  mut found = Vec::new ()
  for item in .iter program.items
    if item is Item::Const c && is_published (&c.visibility)
      found.push (.clone c.name.text, annotation::read (&c.ty))
  found

infer_all : &Program -> &[(String, Ty)] -> (Store, Vec<Inferred>)
infer_all program globals =
  mut store = Store::new ()
  mut definitions = Vec::new ()
  for item in .iter program.items
    case item of
      Item::Fn f ->
        definitions.push (one f None (&mut store) globals)
      Item::Instance block ->
        owner = .clone block.target.head.text
        for member in .iter block.members
          if member is ClassMember::Method f
            definitions.push (one f (Some (&owner)) (&mut store) globals)
      Item::Class block ->
        for member in .iter block.members
          if member is ClassMember::Method f
            definitions.push (one f None (&mut store) globals)
      _ -> ()
  (store, definitions)

grown_globals : &[Inferred] -> &crate::driver::Outcome -> &[(String, Ty)] -> Vec<(String, Ty)>
grown_globals definitions outcome globals =
  mut found = .to_vec globals
  for definition in .iter definitions
    if .is_some definition.owner
      continue
    if .any (\pair -> pair.0 == definition.name) (.iter found)
      continue
    resolved = .judged outcome definition
    if .is_empty (.holes resolved)
      found.push (.clone definition.name, resolved)
  found

raise_receivers : &mut [Inferred] -> &Program -> ()
raise_receivers definitions program =
  calls = call_edges program
  mut rounds = 0
  mut changed = true
  while changed && rounds < 4
    changed := false
    rounds += 1
    for edge in .iter calls
      if receiver_mode definitions (&edge.0) is Some needed && raise_in definitions (&edge.1) (&edge.2) needed
        changed := true
  ()

written_globals : &Program -> Vec<(String, Ty)>
written_globals program =
  mut found = Vec::new ()
  for item in .iter program.items
    if item is Item::Fn f && signature_type (&f.sig) None is Some written
      found.push (.clone f.name.text, written)
  found

raise_rows : &mut [Inferred] -> &Program -> ()
raise_rows definitions program =
  mut rounds = 0
  mut changed = true
  while changed && rounds < ROW_ROUNDS
    changed := false
    rounds += 1
    known = row_table definitions
    for item in .iter program.items
      for f in methods_of item
        reached = crate::infer_row::clause_row_with (.as_slice f.clauses) (.as_slice known)
        if join_into definitions (&f.name.text) (&reached)
          changed := true
  ()

export const ROW_ROUNDS : u32 = 8

row_table : &[Inferred] -> Vec<(String, crate::row::Row)>
row_table definitions =
  mut found = Vec::new ()
  for definition in .iter definitions
    found.push (.clone definition.name, .clone definition.row)
  found

join_into : &mut [Inferred] -> &str -> &crate::row::Row -> bool
join_into definitions name reached =
  mut changed = false
  for definition in .iter_mut definitions
    if definition.name == name && !.is_subrow_of (&definition.row) reached
      definition.row := .join reached definition.row
      changed := true
  changed

call_edges : &Program -> Vec<(String, String, String)>
call_edges program =
  mut found = Vec::new ()
  for item in .iter program.items
    for f in methods_of item
      for call in crate::infer_mode::calls_on (.as_slice f.clauses)
        found.push (call.0, .clone f.name.text, call.1)
  found

methods_of : &Item -> Vec<&voltaic_ast::FnDecl>
methods_of item =
  mut found = Vec::new ()
  case item of
    Item::Fn f -> found.push f
    Item::Instance block ->
      for member in .iter block.members
        if member is ClassMember::Method f
          found.push f
    Item::Class block ->
      for member in .iter block.members
        if member is ClassMember::Method f
          found.push f
    _ -> ()
  found

receiver_mode : &[Inferred] -> &str -> Option<crate::mode::Mode>
receiver_mode definitions name =
  for definition in .iter definitions
    if definition.name == name
      for pair in .iter definition.modes
        if pair.0 == "self"
          return Some pair.1
  None

raise_in : &mut [Inferred] -> &str -> &str -> crate::mode::Mode -> bool
raise_in definitions caller binder needed =
  mut changed = false
  for definition in .iter_mut definitions
    if definition.name == caller
      for pair in .iter_mut definition.modes
        if pair.0 == binder && pair.1 < needed
          pair.1 := needed
          changed := true
  changed

one : &voltaic_ast::FnDecl -> Option<&str> -> &mut Store -> &[(String, Ty)] -> Inferred
one f owner store globals =
  mut env = .to_vec globals
  mut params = Vec::new ()
  for p in .iter f.sig.params
    hole = .fresh_hole store
    if .as_ref p.ty is Some written
      .require (Obligation::Unify {
        left = .clone hole,
        right = annotation::read written,
      }) p.span Reason::Ascribed store
    if crate::infer_mode::binder_of (&p.name.text) == "self" && owner is Some target
      .require (Obligation::Unify {
        left = .clone hole,
        right = Ty::named target,
      }) p.span Reason::ClassRequirement store
    env.push (.clone p.name.text, .clone hole)
    params.push hole
  body = clause_type (.as_slice f.clauses) store (.as_slice env)
  if .as_ref f.sig.ret is Some written
    .require (Obligation::Unify {
      left = .clone body,
      right = annotation::read written,
    }) f.sig.span Reason::Ascribed store
  whole = arrow_of (.as_slice params) (&body)
  written = signature_type (&f.sig) owner
  Inferred {
    name = .clone f.name.text,
    ty = whole,
    row = row_of (&f.sig) (.as_slice f.clauses),
    modes = modes_of (&f.sig) (.as_slice f.clauses),
    written,
    written_modes = written_modes_of (&f.sig),
    published = is_published (&f.visibility),
    owner = .map (\o -> .to_string o) owner,
    span = f.span,
  }

is_published : &Visibility -> bool
is_published visibility = case visibility of
  Visibility::Private -> false
  _ -> true

modes_of : &voltaic_ast::Signature -> &[voltaic_ast::Clause] -> Vec<(String, crate::mode::Mode)>
modes_of sig clauses =
  mut found = Vec::new ()
  for p in .iter sig.params
    found.push (.to_string (crate::infer_mode::binder_of (&p.name.text)), crate::infer_mode::mode_of (&p.name.text) clauses)
  found

written_modes_of : &voltaic_ast::Signature -> Vec<(String, crate::mode::Mode)>
written_modes_of sig =
  mut found = Vec::new ()
  for p in .iter sig.params
    binder = .to_string (crate::infer_mode::binder_of (&p.name.text))
    if crate::mode::Mode::of_receiver (&p.name.text) is Some receiver
      found.push (binder, receiver)
    else if .as_ref p.ty is Some written
      found.push (binder, crate::mode::Mode::of_written (&annotation::read written))
  found

row_of : &voltaic_ast::Signature -> &[voltaic_ast::Clause] -> crate::row::Row
row_of sig clauses =
  mut found = crate::infer_row::clause_row clauses
  if sig.is_async
    found := .join (&crate::row::Row::single crate::effect::Effect::Suspends) found
  if .as_ref sig.ret is Some written && crate::infer_row::fail_of (&annotation::read written) is Some raised
    found := .join (&crate::row::Row::single raised) found
  found

signature_type : &voltaic_ast::Signature -> Option<&str> -> Option<Ty>
signature_type sig owner =
  declared = (.as_ref sig.ret)?
  mut params = Vec::new ()
  for p in .iter sig.params
    if .as_ref p.ty is Some written
      params.push (annotation::read written)
    else if crate::infer_mode::binder_of (&p.name.text) == "self" && owner is Some target
      params.push (Ty::named target)
    else
      return None
  ret = annotation::read declared
  whole = arrow_of (.as_slice params) (&ret)
  if owner is Some target
    return Some (annotation::with_owner (&whole) target)
  Some whole

clause_type : &[voltaic_ast::Clause] -> &mut Store -> &[(String, Ty)] -> Ty
clause_type clauses store env =
  result = .fresh_hole store
  for clause in .iter clauses
    case &clause.body of
      ClauseBody::Plain block ->
        found = block_type block store env
        .require (Obligation::Unify {
          left = .clone result,
          right = found,
        }) clause.span Reason::EquationBody store
        ()
      ClauseBody::Guarded arms ->
        for arm in .iter arms
          if .as_ref arm.condition is Some condition
            for held in .sources condition
              seen = expr_type held store env
              if !.has_pattern condition
                .require (Obligation::Unify {
                  left = seen,
                  right = Ty::named "bool",
                }) arm.span Reason::GuardCondition store
          found = block_type (&arm.body) store env
          .require (Obligation::Unify {
            left = .clone result,
            right = found,
          }) arm.span Reason::EquationBody store
  result

export block_type : &Block -> &mut Store -> &[(String, Ty)] -> Ty
block_type block store env =
  mut last = Ty::unit ()
  for stmt in .iter block.stmts
    last := expr_type (&stmt.expr) store env
  last

export expr_type : &Expr -> &mut Store -> &[(String, Ty)] -> Ty
expr_type e store env = case e of
  Expr::Num { .. } -> .fresh_hole store
  Expr::Bool { .. } -> Ty::named "bool"
  Expr::Char { .. } -> Ty::named "char"
  Expr::StrLit { .. } -> str_ref ()
  Expr::StrInterp { .. } -> Ty::named "String"
  Expr::Unit { .. } -> Ty::unit ()
  Expr::Field { recv, name, span, .. } ->
    owner = expr_type recv store env
    result = .fresh_hole store
    .require (Obligation::Member {
      recv = owner,
      name = .clone name.text,
      result = .clone result,
    }) (*span) Reason::FieldAccess store
    result
  Expr::Paren { inner, .. } -> expr_type inner store env
  Expr::Ident name -> lookup (&name.text) store env
  Expr::Path { text, .. } -> lookup text store env
  Expr::Ascribe { inner, ty, span, .. } ->
    declared = annotation::read ty
    seen = expr_type inner store env
    .require (Obligation::Unify {
      left = seen,
      right = .clone declared,
    }) (*span) Reason::Ascribed store
    declared
  Expr::Binary { op, lhs, rhs, span, .. } ->
    left = expr_type lhs store env
    right = expr_type rhs store env
    binary_type (*op) left right (*span) store
  Expr::Call { callee, args, span, .. } ->
    head = expr_type callee store env
    mut seen = Vec::new ()
    for a in .iter args
      seen.push (expr_type a store env)
    result = .fresh_hole store
    .require (Obligation::Callable {
      callee = head,
      args = seen,
      result = .clone result,
    }) (*span) Reason::CallCallee store
    result
  Expr::Block { body, .. } -> block_type body store env
  Expr::If { then_block, r#otherwise, span, .. } ->
    taken = block_type then_block store env
    if .as_ref (*r#otherwise) is Some other
      skipped = block_type other store env
      .require (Obligation::Unify {
        left = .clone taken,
        right = skipped,
      }) (*span) Reason::EquationBody store
    taken
  _ -> .fresh_hole store

str_ref : Ty
str_ref = Ty::applied "&" (vec! \-> Ty::named "str")

binary_type : BinaryOp -> Ty -> Ty -> voltaic_ast::Span -> &mut Store -> Ty
binary_type op left right span store =
  if is_comparison op
    .require (Obligation::Unify {
      left,
      right,
    }) span Reason::EquationBody store
    return Ty::named "bool"
  if op == BinaryOp::And || op == BinaryOp::Or
    .require (Obligation::Unify {
      left,
      right = Ty::named "bool",
    }) span Reason::GuardCondition store
    .require (Obligation::Unify {
      left = right,
      right = Ty::named "bool",
    }) span Reason::GuardCondition store
    return Ty::named "bool"
  if is_arithmetic op
    .require (Obligation::Unify {
      left = .clone left,
      right,
    }) span Reason::EquationBody store
    return left
  .fresh_hole store

is_comparison : BinaryOp -> bool
is_comparison op = case op of
  BinaryOp::Eq or BinaryOp::Ne or BinaryOp::Lt or BinaryOp::Gt or BinaryOp::Le or BinaryOp::Ge -> true
  _ -> false

is_arithmetic : BinaryOp -> bool
is_arithmetic op = case op of
  BinaryOp::Add or BinaryOp::Sub or BinaryOp::Mul or BinaryOp::Div or BinaryOp::Rem -> true
  _ -> false

lookup : &str -> &mut Store -> &[(String, Ty)] -> Ty
lookup name store env =
  for pair in .rev (.iter env)
    if pair.0 == name
      return .clone pair.1
  .fresh_hole store
