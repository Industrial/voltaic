import crate::effect::Effect
import crate::row::Row
import crate::ty::Ty
import voltaic_ast::BinaryOp
import voltaic_ast::Block
import voltaic_ast::ClauseBody
import voltaic_ast::Expr

export const IO_MACROS : &[&str] = &["println", "print", "eprintln", "eprint"]

export const PANICKING : &[&str] = &["unwrap", "expect", "unwrap_err", "must"]

export const NO_CALLEES : &[(String, Row)] = &[]

export clause_row : &[voltaic_ast::Clause] -> Row
clause_row clauses = clause_row_with clauses NO_CALLEES

export clause_row_with : &[voltaic_ast::Clause] -> &[(String, Row)] -> Row
clause_row_with clauses known =
  mut found = Row::empty ()
  for clause in .iter clauses
    case &clause.body of
      ClauseBody::Plain block ->
        found := .join (&block_row_with block known) found
        ()
      ClauseBody::Guarded arms ->
        for arm in .iter arms
          if .as_ref arm.condition is Some condition
            for held in .sources condition
              found := .join (&expr_row_with held known) found
          found := .join (&block_row_with (&arm.body) known) found
  found

export block_row : &Block -> Row
block_row block = block_row_with block NO_CALLEES

export block_row_with : &Block -> &[(String, Row)] -> Row
block_row_with block known =
  mut found = Row::empty ()
  for stmt in .iter block.stmts
    found := .join (&expr_row_with (&stmt.expr) known) found
  found

export expr_row : &Expr -> Row
expr_row e = expr_row_with e NO_CALLEES

export expr_row_with : &Expr -> &[(String, Row)] -> Row
expr_row_with e known = case e of
  Expr::Try { inner, .. } -> .discharge_fallible (expr_row_with inner known)
  Expr::TryBlock { body, .. } -> .discharge_fallible (block_row_with body known)
  Expr::Await { value, .. } -> .join (&Row::single Effect::Suspends) (expr_row_with value known)
  Expr::AsyncBlock { body, .. } -> .join (&Row::single Effect::Suspends) (block_row_with body known)
  Expr::MacroCall { name, args, .. } ->
    mut found = Row::empty ()
    for a in .iter args
      found := .join (&expr_row_with a known) found
    if .contains (&.as_str name) IO_MACROS
      found := .join (&Row::single Effect::Performs) found
    found
  Expr::MacroVerbatim { name, .. } | .contains (&.as_str name) IO_MACROS -> Row::single Effect::Performs
  Expr::Assign { target, value, .. } ->
    region = root_of target
    .join (&Row::single (Effect::Mutates region)) (.join (&expr_row_with value known) (expr_row_with target known))
  Expr::Binary { op, lhs, rhs, .. } ->
    both = .join (&expr_row_with rhs known) (expr_row_with lhs known)
    if *op == BinaryOp::Catch || *op == BinaryOp::Coalesce
      return .discharge_fallible both
    both
  Expr::Call { callee, args, .. } ->
    mut found = expr_row_with callee known
    for a in .iter args
      found := .join (&expr_row_with a known) found
    found
  Expr::Dot { recv, name, args, .. } ->
    mut found = expr_row_with recv known
    for a in .iter args
      found := .join (&expr_row_with a known) found
    if .contains (&.as_str name.text) PANICKING
      return .join (&Row::single Effect::Panics) found
    .join (&called (&name.text) known) found
  Expr::Ident name -> called (&name.text) known
  Expr::MethodRef { name, .. } ->
    if .contains (&.as_str name.text) PANICKING
      return Row::single Effect::Panics
    called (&name.text) known
  Expr::Field { recv, .. } -> expr_row_with recv known
  Expr::Index { recv, index, .. } -> .join (&expr_row_with index known) (expr_row_with recv known)
  Expr::Paren { inner, .. } -> expr_row_with inner known
  Expr::Ascribe { inner, .. } -> expr_row_with inner known
  Expr::Block { body, .. } -> block_row_with body known
  Expr::UnsafeBlock { body, .. } -> block_row_with body known
  Expr::BindBlock { body, .. } -> .discharge_fallible (block_row_with body known)
  Expr::Draw { value, .. } -> expr_row_with value known
  Expr::Return { value, .. } ->
    if .as_ref (*value) is Some held
      return expr_row_with held known
    Row::empty ()
  Expr::If { then_block, r#otherwise, .. } ->
    mut found = block_row_with then_block known
    if .as_ref (*r#otherwise) is Some other
      found := .join (&block_row_with other known) found
    found
  Expr::Break { .. } -> Row::single Effect::Diverges
  Expr::Continue { .. } -> Row::single Effect::Diverges
  _ -> Row::empty ()

called : &str -> &[(String, Row)] -> Row
called name known =
  for pair in .iter known
    if pair.0 == name
      return .clone pair.1
  Row::empty ()

root_of : &Expr -> String
root_of target = case target of
  Expr::Ident name -> .clone name.text
  Expr::Field { recv, .. } -> root_of recv
  Expr::Index { recv, .. } -> root_of recv
  Expr::SelfField { .. } -> .to_string "self"
  Expr::Paren { inner, .. } -> root_of inner
  _ -> .to_string "?"

export fail_of : &Ty -> Option<Effect>
fail_of declared = case declared of
  Ty::Con { name, args, .. } ->
    if name == "Result" && .len args == 2
      return Some (Effect::Fails (.clone args[1]))
    if name == "Option" && .len args == 1
      return Some Effect::Absent
    None
  _ -> None

test "a pure body has a pure row"
  assert! \-> .is_empty (expr_row (&Expr::Unit {
    span = (0, 2),
  }))

test "break and continue diverge"
  assert! \-> .holds (&Effect::Diverges) (expr_row (&Expr::Continue {
    label = None,
    span = (0, 8),
  }))

test "a Result return type reads as a fail effect carrying its error"
  declared = Ty::applied "Result" (vec! \-> Ty::named "i32" \-> Ty::named "String")
  assert_eq! \-> fail_of (&declared) \-> Some (Effect::Fails (Ty::named "String"))

test "an Option return type reads as the absence effect"
  declared = Ty::applied "Option" (vec! \-> Ty::named "char")
  assert_eq! \-> fail_of (&declared) \-> Some Effect::Absent

test "an ordinary type carries no effect"
  assert_eq! \-> fail_of (&Ty::named "u64") \-> None
  assert_eq! \-> fail_of (&Ty::applied "Vec" (vec! \-> Ty::named "u8")) \-> None

test "the io macros are the four printing ones"
  assert_eq! \-> .len IO_MACROS \-> 4
  assert! \-> .contains (&"println") IO_MACROS
  assert! \-> !.contains (&"format") IO_MACROS \-> "format! performs no io"

test "a mention of a name with no known row contributes nothing"
  mentioned = Expr::Ident (voltaic_ast::Ident {
    text = .to_string "announce",
    span = (0, 8),
  })
  assert! \-> .is_empty (expr_row (&mentioned))

test "a mention of a name with a known row carries that row to the caller"
  mentioned = Expr::Ident (voltaic_ast::Ident {
    text = .to_string "announce",
    span = (0, 8),
  })
  known = vec! \-> (.to_string "announce", Row::single Effect::Performs)
  assert! \-> .holds (&Effect::Performs) (expr_row_with (&mentioned) (.as_slice known))

test "an unrelated name in the table is not picked up"
  mentioned = Expr::Ident (voltaic_ast::Ident {
    text = .to_string "quiet",
    span = (0, 5),
  })
  known = vec! \-> (.to_string "announce", Row::single Effect::Performs)
  assert! \-> .is_empty (expr_row_with (&mentioned) (.as_slice known))
