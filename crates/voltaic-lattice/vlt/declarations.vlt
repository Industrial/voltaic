import crate::annotation
import crate::ty::Ty
import voltaic_ast::ClassMember
import voltaic_ast::ConstructorFields
import voltaic_ast::Item
import voltaic_ast::Program

export data Member = Member { export owner : String, export name : String, export ty : Ty }
  deriving (Debug, Clone, PartialEq, Eq)

export data Requirement = Requirement { export class_name : String, export name : String }
  deriving (Debug, Clone, PartialEq, Eq)

export data Alias = Alias { export name : String, export ty : Ty }
  deriving (Debug, Clone, PartialEq, Eq)

export data Declarations = Declarations { export members : Vec<Member>, export requirements : Vec<Requirement>, export types : Vec<String>, export aliases : Vec<Alias> }
  deriving (Debug, Clone, Default)

instance Declarations
  export empty : Self
  empty = Declarations { members = Vec::new (), requirements = Vec::new (), types = Vec::new (), aliases = Vec::new () }

  export len : &self -> usize
  len self = .len self.members

  export is_empty : &self -> bool
  is_empty self = .is_empty self.members

  export alias : &str -> &self -> Option<&Ty>
  alias name self =
    for held in .iter self.aliases
      if held.name == name
        return Some (&held.ty)
    None

  export expand : &Ty -> &self -> Ty
  expand t self =
    mut seen = Vec::new ()
    expand_within t self (&mut seen)

  export knows : &str -> &self -> bool
  knows name self = .any (\t -> t == name) (.iter self.types)

  export member : &str -> &str -> &self -> Option<&Ty>
  member owner name self =
    for held in .iter self.members
      if held.owner == owner && held.name == name
        return Some (&held.ty)
    None

  export members_of : &str -> &self -> Vec<&Member>
  members_of owner self = self.members |> .iter |> .filter (\m -> m.owner == owner) |> .collect

  export requires : &str -> &self -> Vec<&Requirement>
  requires class_name self = self.requirements |> .iter |> .filter (\r -> r.class_name == class_name) |> .collect

  export satisfies : &str -> &str -> &self -> bool
  satisfies owner class_name self =
    needed = .requires class_name self
    if .is_empty needed
      return false
    for requirement in needed
      if .is_none (.member owner (&requirement.name) self)
        return false
    true

expand_within : &Ty -> &Declarations -> &mut Vec<String> -> Ty
expand_within t known seen = case t of
  Ty::Con { name, args, .. } ->
    if .is_empty args && !.contains name seen && .alias name known is Some defined
      seen |> .push (.clone name)
      return expand_within defined known seen
    Ty::applied name (.collect (.map (\a -> expand_within a known seen) (.iter args)))
  _ -> .clone t

export collect : &Program -> Declarations
collect program =
  mut found = Declarations::empty ()
  for item in .iter program.items
    case item of
      Item::Data d ->
        found.types |> .push (.clone d.name.text)
        for constructor in .iter d.constructors
          case &constructor.fields of
            ConstructorFields::Record fields ->
              for field in .iter fields
                found.members |> .push (Member { owner = .clone d.name.text, name = .clone field.name.text, ty = annotation::read (&field.ty) })
              ()
            ConstructorFields::Tuple every ->
              for pair in .enumerate (.iter every)
                found.members |> .push (Member { owner = .clone d.name.text, name = .to_string (format! \-> "#{pair.0}"), ty = annotation::read pair.1 })
              ()
            ConstructorFields::Unit -> ()
        ()
      Item::Class c ->
        found.types |> .push (.clone c.name.text)
        for member in .iter c.members
          case member of
            ClassMember::Method f ->
              found.requirements |> .push (Requirement { class_name = .clone c.name.text, name = .clone f.name.text })
              ()
            ClassMember::AssocConst { name, .. } ->
              found.requirements |> .push (Requirement { class_name = .clone c.name.text, name = .clone name.text })
              ()
            ClassMember::AssocType _ -> ()
        ()
      Item::Instance block ->
        owner = .clone block.target.head.text
        for member in .iter block.members
          if member is ClassMember::Method f && .as_ref f.sig.ret is Some written
            found.members |> .push (Member { owner = .clone owner, name = .clone f.name.text, ty = annotation::read written })
        ()
      Item::Type a ->
        found.aliases |> .push (Alias { name = .clone a.name.text, ty = annotation::read (&a.ty) })
        ()
      _ -> ()
  found

test "a type alias is recorded and expands to its definition"
  source = "type Depth = f64\n"
  program = .expect "should parse" (voltaic_parser::parse_source source)
  found = collect (&program)
  assert_eq! \-> .alias "Depth" found \-> Some (&Ty::named "f64")
  assert_eq! \-> .expand (&Ty::named "Depth") found \-> Ty::named "f64"

test "a name with no alias expands to itself"
  found = Declarations::empty ()
  assert_eq! \-> .expand (&Ty::named "u64") found \-> Ty::named "u64"

test "an alias inside an applied type is expanded too"
  source = "type Depth = f64\n"
  program = .expect "should parse" (voltaic_parser::parse_source source)
  found = collect (&program)
  written = Ty::applied "Vec" (vec! \-> Ty::named "Depth")
  assert_eq! \-> .to_string (.expand (&written) found) \-> "Vec<f64>"

test "a chain of aliases expands all the way down"
  source = "type Depth = Fathoms\ntype Fathoms = f64\n"
  program = .expect "should parse" (voltaic_parser::parse_source source)
  found = collect (&program)
  assert_eq! \-> .expand (&Ty::named "Depth") found \-> Ty::named "f64"

test "a cyclic alias stops rather than looping"
  source = "type Loop = Loop\n"
  program = .expect "should parse" (voltaic_parser::parse_source source)
  found = collect (&program)
  assert_eq! \-> .expand (&Ty::named "Loop") found \-> Ty::named "Loop" \-> "rustc rejects the cycle; Lattice only has to terminate"

test "a newtype is not an alias, because it is a distinct type"
  source = "newtype Meters = Meters f64\n"
  program = .expect "should parse" (voltaic_parser::parse_source source)
  found = collect (&program)
  assert_eq! \-> .alias "Meters" found \-> None
  assert_eq! \-> .member "Meters" "0" found \-> Some (&Ty::named "f64")

test "a record's fields become members of its type"
  source = "data Point = Point { x : f64, y : f64 }\n"
  program = .expect "should parse" (voltaic_parser::parse_source source)
  found = collect (&program)
  assert! \-> .knows "Point" found
  assert_eq! \-> .member "Point" "x" found \-> Some (&Ty::named "f64")
  assert_eq! \-> .member "Point" "y" found \-> Some (&Ty::named "f64")
  assert_eq! \-> .member "Point" "z" found \-> None

test "a tuple constructor's fields are numbered"
  source = "data Tag = Tag String\n"
  program = .expect "should parse" (voltaic_parser::parse_source source)
  found = collect (&program)
  assert_eq! \-> .member "Tag" "0" found \-> Some (&Ty::named "String")

test "a unit constructor contributes a type and no members"
  source = "data Closed = Closed\n"
  program = .expect "should parse" (voltaic_parser::parse_source source)
  found = collect (&program)
  assert! \-> .knows "Closed" found
  assert! \-> .is_empty found

test "a class's methods become its requirements"
  source = "class Shape\n  area : &self -> f64\n"
  program = .expect "should parse" (voltaic_parser::parse_source source)
  found = collect (&program)
  assert_eq! \-> .len (.requires "Shape" found) \-> 1
  assert_eq! \-> (.requires "Shape" found)[0].name \-> "area"

test "an unknown type is not known"
  found = Declarations::empty ()
  assert! \-> !.knows "Nothing" found
  assert! \-> .is_empty found

test "satisfaction is false for a class nobody declared"
  found = Declarations::empty ()
  assert! \-> !.satisfies "Square" "Shape" found
